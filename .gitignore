# Build output
#
# The CLI binary is anchored to the repository root on purpose: a bare `rung`
# would also match the cmd/rung *directory*, silently excluding the command's
# source from every commit.
/dist/
/bin/
/rung

# Test and coverage output
coverage.out
coverage.txt
*.test

# Editors
.idea/
.vscode/
*.swp

# macOS
.DS_Store

# Local environment
.env
.env.local
